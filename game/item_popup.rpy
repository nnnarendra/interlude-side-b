    def show_item(item_id):
        """Tampilkan kartu gambar item/makanan di tengah-atas layar."""
        if item_id in ITEM_CATALOG:
            renpy.show_screen("item_popup", item_id=item_id)

    def hide_item():
        """Sembunyikan kartu gambar item/makanan beserta kartu detailnya jika sedang tampil."""
        if renpy.get_screen("item_detail_card"):
            renpy.hide_screen("item_detail_card")
        if renpy.get_screen("item_popup"):
            renpy.hide_screen("item_popup")

    _CHAR_SPRITE_TAGS = ("kai", "yara", "ageng", "kaya")

    def _item_popup_pos():
        """
        Jika hanya 1 karakter tampil di layar (biasanya di tengah), geser kartu item ke sisi kanan
        agar tidak menutupi wajah karakter. Jika 2+ karakter (kiri & kanan), taruh di tengah-atas.
        """
        try:
            tags = renpy.get_showing_tags("master")
            char_count = sum(1 for t in tags if t in _CHAR_SPRITE_TAGS or str(t).startswith("npc_"))
            if char_count == 1:
                return (0.88, 120)
        except Exception:
            pass
        return (0.5, 42)

transform item_popup_anim:
    alpha 0.0
    yoffset 16
    easein 0.24 alpha 1.0 yoffset 0

transform item_detail_anim:
    alpha 0.0
    zoom 0.96
    easein 0.18 alpha 1.0 zoom 1.0

screen item_popup(item_id):
    zorder 80

    $ _it = ITEM_CATALOG.get(item_id)
    if _it is not None:
        $ _is_en = (persistent.story_lang == "en")
        $ _it_name = _it["name_en"] if _is_en else _it["name_id"]
        $ _it_hint = "Tap for info" if _is_en else "Klik untuk info"
        $ _px, _py = _item_popup_pos()

        button at item_popup_anim:
            xalign _px
            ypos _py
            xsize 340
            background Solid("#1c1410e0")
            hover_background Solid("#2b1f17f2")
            padding (20, 14)
            action Show("item_detail_card", item_id=item_id)

            vbox:
                spacing 8
                xalign 0.5

                add Solid("#e0a55e") xsize 296 ysize 3 xalign 0.5

                frame:
                    xsize 228
                    ysize 228
                    xalign 0.5
                    background Solid("#281e17b0")
                    padding (10, 10)
                    add _it["file"] xysize (208, 208) fit "contain" align (0.5, 0.5)

                text _it_name:
                    size 23
                    bold True
                    color "#f4c98b"
                    xalign 0.5
                    text_align 0.5
                    substitute False

                text _it_hint:
                    size 16
                    color "#b8a38b"
                    xalign 0.5
                    substitute False

