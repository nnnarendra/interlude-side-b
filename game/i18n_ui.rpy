    def ui_tr(key, **kwargs):
        """Satu-satunya fungsi terjemahan UI untuk seluruh antarmuka (dikendalikan persistent.ui_lang)."""
        lang = persistent.ui_lang if persistent.ui_lang in UI_STRINGS else "id"
        table = UI_STRINGS[lang]
        text = table.get(key)
        if text is None:
            text = UI_STRINGS["id"].get(key, key)
        if kwargs:
            try:
                return text.format(**kwargs)
            except Exception:
                return text
        return text

    def ui_confirm_text(message):
        """Peta pesan konfirmasi & notifikasi bawaan Ren'Py agar selalu mengikuti Bahasa UI (persistent.ui_lang)."""
        mapping = {
            layout.ARE_YOU_SURE: "confirm_sure",
            layout.DELETE_SAVE: "confirm_delete",
            layout.OVERWRITE_SAVE: "confirm_overwrite",
            layout.LOADING: "confirm_load",
            layout.QUIT: "confirm_quit",
            layout.MAIN_MENU: "confirm_main_menu",
            layout.CONTINUE: "confirm_continue",
            layout.END_REPLAY: "confirm_end_replay",
            layout.SLOW_SKIP: "confirm_slow_skip",
            layout.FAST_SKIP_SEEN: "confirm_fast_skip_seen",
            layout.FAST_SKIP_UNSEEN: "confirm_fast_skip_unseen",
            "Quick save complete.": "notify_quick_saved",
        }
        key = mapping.get(message)
        if key:
            return ui_tr(key)
        if message in UI_STRINGS["id"]:
            return ui_tr(message)
        return message

    def sync_preferences_with_persistent():
        """Sinkronkan _preferences.language & kecepatan baca dengan variabel persisten tanpa memanggil change_language saat init."""
        _ensure_persistent_containers()
        _preferences.language = None if persistent.story_lang == "id" else "en"
        apply_read_speed()

    class SetUILanguage(Action, DictEquality):
        """Ganti Bahasa UI (id/en) secara langsung tanpa menyentuh Bahasa Cerita."""
        def __init__(self, lang):
            self.lang = lang if lang in ("id", "en") else "id"

        def __call__(self):
            _ensure_persistent_containers()
            persistent.ui_lang = self.lang
            renpy.save_persistent()
            renpy.restart_interaction()

        def get_selected(self):
            _ensure_persistent_containers()
            return persistent.ui_lang == self.lang

    class SetStoryLanguage(Action, DictEquality):
        """Ganti Bahasa Cerita (id/en) lewat translation framework Ren'Py tanpa mengubah Bahasa UI."""
        def __init__(self, lang):
            self.lang = lang if lang in ("id", "en") else "id"

        def __call__(self):
            _ensure_persistent_containers()
            persistent.story_lang = self.lang
            renpy.save_persistent()
            target_renpy_lang = None if self.lang == "id" else "en"
            renpy.change_language(target_renpy_lang, force=True)
            renpy.restart_interaction()

        def get_selected(self):
            _ensure_persistent_containers()
            return persistent.story_lang == self.lang

    config.start_callbacks.append(sync_preferences_with_persistent)
    config.after_load_callbacks.append(sync_preferences_with_persistent)

